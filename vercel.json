{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guides/analyze-and-categorize-client-feedback-using-ai-by-zapier",
      "destination": "/guides/turn-client-revision-requests-into-trackable-tasks-with-ai-by-zapier/",
      "permanent": true
    },
    {
      "source": "/guides/analyze-and-categorize-client-feedback-using-ai-by-zapier/",
      "destination": "/guides/turn-client-revision-requests-into-trackable-tasks-with-ai-by-zapier/",
      "permanent": true
    },
    {
      "source": "/guides/analyze-and-categorize-client-feedback-using-ai-by-zapier/index.html",
      "destination": "/guides/turn-client-revision-requests-into-trackable-tasks-with-ai-by-zapier/",
      "permanent": true
    }
  ]
}
